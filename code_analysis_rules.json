{
  "log_level": "all",
  "fail_on": "warning",
  "max_lines_per_file": {
    "enabled": true,
    "warning": 300,
    "error": 500,
    "exclude_patterns": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".git/**",
      ".venv/**",
      "venv/**",
      "code_analysis_results/**"
    ]
  },
  "pmd_duplicates": {
    "enabled": true,
    "minimum_tokens": 100,
    "exclude_patterns": {
      "python": [
        "__pycache__/**",
        "*.pyc",
        "venv/**",
        ".venv/**",
        "env/**",
        ".git/**",
        "code_analysis_results/**"
      ]
    }
  },
  "pmd_similar_code": {
    "enabled": false,
    "minimum_tokens": 100,
    "ignore_identifiers": true,
    "ignore_literals": true,
    "ignore_annotations": false
  },
  "ruff_analyze": {
    "enabled": true,
    "select": [
      "F",
      "E4",
      "E7",
      "E9",
      "W",
      "I",
      "B",
      "UP",
      "SIM",
      "C4",
      "PIE",
      "ARG",
      "RUF"
    ],
    "ignore": [],
    "exclude_patterns": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".git/**",
      ".venv/**",
      "venv/**",
      "code_analysis_results/**"
    ]
  },
  "semgrep_analyze": {
    "enabled": true,
    "config": null,
    "exclude_patterns": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".git/**",
      ".venv/**",
      "venv/**",
      "code_analysis_results/**"
    ]
  }
}
